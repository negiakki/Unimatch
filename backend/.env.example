# Copy to `.env` and fill in real values. Never commit the filled file.

PROJECT_NAME=UniMatch API
DEBUG=false

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Supabase (server-side credentials only - never expose to the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Supabase HTTP transport (tune for the deployed environment).
# HTTP/2 is disabled by design; see app/services/supabase.py.
SUPABASE_HTTP_TIMEOUT_SECONDS=20
SUPABASE_HTTP_MAX_CONNECTIONS=20
SUPABASE_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
SUPABASE_HTTP_MAX_ATTEMPTS=2
